DATABASE_URL=postgresql://snow:snow@localhost:5432/snow
# Публичный адрес сайта (для ссылок в Telegram и sitemap)
SITE_URL=http://localhost:3000
# Секрет для подписи сессии админа (openssl rand -hex 32)
AUTH_SECRET=change-me
# Секрет для cron-эндпоинта повторной отправки уведомлений
CRON_SECRET=change-me
# Telegram-бот (необязательно; можно также задать в админке)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Каталог загрузок (вне public)
UPLOAD_DIR=./uploads
# Первый администратор (npm run admin:create)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Только для docker-compose на сервере ---
DB_PASSWORD=change-me
SITE_DOMAIN=example.ru
